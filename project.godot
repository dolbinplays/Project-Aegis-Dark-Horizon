; Project Aegis native Godot 4 vertical slice.
; The verified HTML build remains index.html.

config_version=5

[application]

config/name="Project Aegis: Dark Horizon"
run/main_scene="res://godot/main.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[audio]

default_bus_layout="res://godot/default_bus_layout.tres"

[input]

tactical_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
